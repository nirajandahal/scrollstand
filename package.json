{
  "name": "scrollstand",
  "version": "1.0.0",
  "private": true,
  "description": "Hands-free PDF reader that scrolls at a set speed",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "serve": "npm run build && npx --yes serve www",
    "android:prepare": "npm run build && node scripts/prepare-android.mjs",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  },
  "engines": {
    "node": ">=22"
  }
}
